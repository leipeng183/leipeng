+class _ConfigSectionContext(object):
+    def __init__(self, config_section, source_filename=None,
+                 source_trace=None, strict=True):
+        self._config_section = config_section
+        self.name = config_section.name
+        self.source_filename = source_filename
+        self.source_trace = list(source_trace or [])
+        self.strict = strict
+
+    def __getattr__(self, name):
+        return getattr(self._config_section, name)
+
+
+def _detect_expected_type_name(param):
+    param_type = getattr(param, "type", None)
+    type_name = getattr(param_type, "name", None)
+    if type_name:
+        return type_name
+    if inspect.isclass(param_type):
+        return param_type.__name__
+    if param_type is None:
+        return "value"
+    return param_type.__class__.__name__
+
+
+def _build_param_diagnostic(config_section, param_name, raw_value, param):
+    filename = getattr(config_section, "source_filename", None) or "<unknown>"
+    source_trace = getattr(config_section, "source_trace", None) or [filename]
+    return (
+        "Invalid configuration value: file=%s, section=%s, parameter=%s, "
+        "value=%r, expected_type=%s, source_trace=%s"
+    ) % (filename, config_section.name, param_name, raw_value,
+         _detect_expected_type_name(param), " -> ".join(source_trace))
+
+
+def _reraise_with_diagnostics(error, diagnostic_message):
+    diagnostic_error = BadParameter(diagnostic_message)
+    if hasattr(diagnostic_error, "__cause__"):
+        diagnostic_error.__cause__ = error
+    six.reraise(type(diagnostic_error), diagnostic_error, sys.exc_info()[2])
+
