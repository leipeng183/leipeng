+    def test_read_config__strict_mode_reports_detailed_file_trace(self,
+            isolated_filesystem):
+        _ = isolated_filesystem
+
+        @matches_section("hello")
+        class ExampleSchema(SectionSchema):
+            name = Param(type=str)
+            number = Param(type=int)
+
+        class ConfigFileProcessor(ConfigFileReader):
+            config_files = ["hello.ini"]
+            config_searchpath = [".", "config/profile"]
+            config_section_schemas = [ExampleSchema]
+
+        write_configfile_with_contents("config/profile/hello.ini", """
+            [hello]
+            name = Alice
+            number = 2
+            """)
+        write_configfile_with_contents("hello.ini", """
+            [hello]
+            number = not-a-number
+            """)
+
+        with pytest.raises(BadParameter) as exc_info:
+            ConfigFileProcessor.read_config(strict=True)
+
+        message = str(exc_info.value)
+        assert "file=./hello.ini" in message
+        assert "section=hello" in message
+        assert "parameter=number" in message
+        assert "value='not-a-number'" in message
+        assert "expected_type=integer" in message
+        assert "source_trace=config/profile/hello.ini -> ./hello.ini" in message
+
